# --- Groq (plan gratuito) -----------------------------------------
# Crea una clave en https://console.groq.com/keys y pegala aqui.
OPENAI_API_KEY=
OPENAI_PROVIDER=groq
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# --- Preferencias ------------------------------------------------
OUTPUT_LANGUAGE=espanol
OUTPUT_DIR=./output
OPENAI_AGENTS_DISABLE_TRACING=1
LOW_COST_MODE=1